# Application
NODE_ENV=development
PORT=3003
API_PREFIX=api/v1
API_URL=http://localhost:3003

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/axentyc

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# Frontend origin. Public widget routes also accept customer-owned origins.
CORS_ORIGIN=http://localhost:3000

# Swagger
SWAGGER_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Facebook / Instagram Integration (Meta)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Required: no default. Must match the Verify Token configured in Meta > Webhooks
FACEBOOK_VERIFY_TOKEN=change-me-to-a-long-random-string
# Graph API version (default v23.0)
FACEBOOK_GRAPH_VERSION=v23.0
# Optional polling fallback for comments (webhooks are the primary path)
FACEBOOK_COMMENTS_POLLING_ENABLED=false

# Public URLs (used to build absolute media URLs)
APP_URL=http://localhost:3003
BACKEND_URL=http://localhost:3003

# Firebase Admin SDK (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email Integration
EMAIL_SECRET_KEY=your-email-encryption-secret-key

# Billing / payments (Stripe). Without STRIPE_SECRET_KEY paid plans cannot be activated in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=usd
# Public URL of the web app (checkout / portal return links, billing e-mails)
FRONTEND_URL=http://localhost:3000

# Optional platform e-mail used for trial / payment reminders
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_FROM=AXENTYC <billing@yourdomain.com>

# Set to false only if the API is exposed directly (no reverse proxy)
TRUST_PROXY=true
